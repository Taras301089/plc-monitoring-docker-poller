FUNCTION_BLOCK "FB287_CarID_Time_Info_List"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Authorization : Bool;
      car_in : Bool;
      car_out : Bool;
      countMax : Int := 150;
   END_VAR

   VAR_OUTPUT 
      First : "CarID_Memory";
      alarm : Bool;
   END_VAR

   VAR_IN_OUT 
      carinfo_List : Array[1..150] of "CarID_Memory";
      carInfo_In : "CarID_Memory";
      carInfo_Out : "CarID_Memory";
   END_VAR
   VAR_IN_OUT RETAIN
      listCount : Int;
   END_VAR

   VAR 
      alarmPd : Struct
         count : Bool;
         in : Bool;
         relation : Bool;
         OUT : Bool;
      END_STRUCT;
      count : Int;
      Init { S7_SetPoint := 'False'} : "CarID_Memory";
   END_VAR

   VAR_TEMP 
      i : Int;
      j : Int;
   END_VAR


BEGIN
	REGION 说明
	  
	 
	    //增加自动前移功能，即使不在出缓存的情况下，并先计算apc中缓存中的数量，同时与listcount进行比较如果不相同，报警————-----2019年12月15日
	END_REGION
	REGION 自动前移与计算数量
	    //自动前移
	    FOR #i := 1 TO 150 DO
	        IF #carinfo_List[#i].CarID  = '' THEN
	            #j := #i;
	            WHILE (#j < 150) DO
	                #carinfo_List[#j] := #carinfo_List[#j + 1];
	                #j := #j + 1;
	            END_WHILE;
	            
	            
	            #carinfo_List[150] :=  #Init;
	            
	        END_IF;
	    END_FOR;
	    //计数
	    #count := 0;
	    FOR #i := 1 TO 150 DO
	        IF #carinfo_List[#i].CarID <> '' THEN
	            #count := #count + 1;
	        ELSE
	            EXIT;
	        END_IF;
	    END_FOR;
	END_REGION
	
	REGION  故障
	    IF #listCount > #countMax OR #listCount < 0  OR #count<>#listCount THEN
	        #alarmPd.count := 1;
	    ELSE
	        #alarmPd.count := 0;
	    END_IF;
	
	    IF #carInfo_In.CarID = '' AND #car_in THEN
	        #alarmPd.in := 1;
	    ELSE
	        #alarmPd.in := 0;
	    END_IF;
	    #alarmPd.relation := 0;
	    IF #listCount < #countMax THEN
	        IF #carinfo_List[#listCount + 1].CarID <> '' THEN   //增加一个限定条件，防止cpu在=7的时候死机
	            
	            #alarmPd.relation := 1;
	        ELSE
	            #alarmPd.relation := 0;
	        END_IF;
	    END_IF;
	    IF #car_out AND #carinfo_List[1].CarID = '' THEN
	        #alarmPd.OUT := 1;
	    ELSE
	        #alarmPd.OUT := 0;
	    END_IF;
	    #alarm := #alarmPd.count OR #alarmPd.OUT OR #alarmPd.in OR #alarmPd.relation;
	END_REGION
	
	REGION 进缓存
	    
	   IF #car_in AND #listCount < #countMax AND NOT #alarm THEN
	       
	        #carinfo_List[#listCount + 1] := #carInfo_In;
	        #listCount := #listCount + 1;
	        
	        #carInfo_In := #Init;
	    END_IF;
	END_REGION
	
	REGION 出缓存
	    IF #car_out AND #listCount >0 AND NOT #alarm  THEN
	        #carInfo_Out:=#carinfo_List[1];
	        FOR #i := 1 TO 19 DO
	            #carinfo_List[#i] := #carinfo_List[#i + 1];
	        END_FOR;
	       
	        #carinfo_List[20] := #Init;
	        #listCount := #listCount - 1;
	    END_IF;
	END_REGION
	REGION 获得缓存池第一个车型
	    #First := #carinfo_List[1];
	   
	END_REGION
	
	
	
END_FUNCTION_BLOCK

